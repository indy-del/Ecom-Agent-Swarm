# Server & Environment Configuration
PORT=3000
NODE_ENV=development

# LLM & AI Configuration (Core orchestration)
OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here # Optional: For multi-model fallback routines

# Storefront Platform APIs (Ingestion Layer)
SHOPIFY_API_KEY=your_shopify_api_key_here
SHOPIFY_STORE_DOMAIN=your_store.myshopify.com
ECWID_STORE_ID=your_ecwid_store_id_here
ECWID_ACCESS_TOKEN=your_ecwid_token_here

# Webhook Security
WEBHOOK_SECRET=your_webhook_signing_secret_here

# Logistics & Routing APIs (Execution Layer)
SHIPPING_PARTNER_API_KEY=your_shipping_partner_key_here

# Database Configuration (For local state and order management)
DATABASE_URL=postgres://user:password@localhost:5432/ecom_swarm